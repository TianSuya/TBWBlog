{
  "name": "tbwblog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "serve": "pnpm build && astro preview",
    "check": "astro check",
    "lint:retro": "./scripts/check-retro.sh",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:cms": "node scripts/check-cms-coverage.mjs",
    "smoke": "node scripts/smoke.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "avatar": "node scripts/make-avatar.mjs",
    "verify": "pnpm check && pnpm build && pnpm lint:retro && pnpm lint:contrast && pnpm lint:cms"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^7.1.3",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
