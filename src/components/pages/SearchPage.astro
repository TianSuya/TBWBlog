---
import Base from '../../layouts/Base.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('search.title')}>
  <h1>{t('search.title')}</h1>
  <p class="muted">{t('search.hint')}</p>

  {/*
    Pagefind ships a drop-in UI component, but it is all rounded corners and
    drop shadows. Its JS API gives the same index with markup we control, so
    this is a native <input> and a plain <ul>.

    Pagefind builds one index per language and picks the right one from
    <html lang>, so /search and /zh/search each search their own corpus.
  */}
  <form class="searchbox" id="search-form" role="search">
    <label class="visually-hidden" for="q">{t('search.title')}</label>
    <input
      type="search"
      id="q"
      name="q"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      spellcheck="false"
    />
    <button type="submit">{t('search.button')}</button>
  </form>

  <p id="search-status" class="muted" aria-live="polite"></p>
  <ul class="plain" id="search-results"></ul>
</Base>

<script
  is:inline
  define:vars={{
    loadingText: t('search.loading'),
    noResultsText: t('search.noResults'),
    resultsText: t('search.results'),
  }}
>
  (function () {
    var form = document.getElementById('search-form');
    var input = document.getElementById('q');
    var status = document.getElementById('search-status');
    var list = document.getElementById('search-results');
    if (!form || !input || !status || !list) return;

    var pagefind = null;
    var loadFailed = false;

    async function getPagefind() {
      if (pagefind || loadFailed) return pagefind;
      try {
        // Generated by `pagefind --site dist` during the build, so it does not
        // exist under `astro dev`. Vite must not try to resolve it.
        pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        await pagefind.init();
      } catch (e) {
        loadFailed = true;
        status.textContent =
          'Search index not built. Run `pnpm build && pnpm preview` to try it locally.';
      }
      return pagefind;
    }

    function render(results, total) {
      list.textContent = '';
      for (var i = 0; i < results.length; i++) {
        var r = results[i];
        var li = document.createElement('li');
        li.className = 'entry';

        var a = document.createElement('a');
        a.className = 'entry-title';
        a.href = r.url;
        a.textContent = (r.meta && r.meta.title) || r.url;
        li.appendChild(a);

        var p = document.createElement('p');
        p.className = 'entry-summary';
        // Pagefind's excerpt is trusted HTML from our own build output; it
        // contains only <mark> tags around the matched terms.
        p.innerHTML = r.excerpt;
        li.appendChild(p);

        list.appendChild(li);
      }
      status.textContent = total + ' ' + resultsText;
    }

    async function run(query) {
      if (!query) {
        list.textContent = '';
        status.textContent = '';
        return;
      }

      status.textContent = loadingText;
      var pf = await getPagefind();
      if (!pf) return;

      var search = await pf.search(query);
      if (search.results.length === 0) {
        list.textContent = '';
        status.textContent = noResultsText;
        return;
      }

      var top = await Promise.all(search.results.slice(0, 25).map(function (r) {
        return r.data();
      }));
      render(top, search.results.length);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var q = input.value.trim();
      // Keep the query in the URL so results are linkable and the back button
      // behaves the way it did before single-page apps forgot how.
      var url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
      run(q);
    });

    // Support /search?q=... arriving from elsewhere.
    var initial = new URL(window.location.href).searchParams.get('q');
    if (initial) {
      input.value = initial;
      run(initial);
    }
    input.focus();
  })();
</script>
