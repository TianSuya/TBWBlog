---
import Base from '../../layouts/Base.astro';
import PostList from '../PostList.astro';
import { getPosts } from '../../lib/posts';
import { useTranslations, localizePath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts();
---

<Base lang={lang} title={t('blog.title')}>
  <h1>{t('blog.title')}</h1>

  <p class="brackets">
    <a href={localizePath('/archive', lang)}>{t('nav.archive')}</a>
    <a href={localizePath('/search', lang)}>{t('nav.search')}</a>
    <a href="/rss.xml">{t('footer.rss')}</a>
  </p>

  <hr />

  <PostList lang={lang} posts={posts} />
</Base>
