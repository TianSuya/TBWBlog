# Copy to deploy/.env on the server and fill in. Never commit the real file.
#
#   cp umami.env.example .env
#   sed -i "s|CHANGEME_SECRET|$(openssl rand -base64 32)|"  .env
#   sed -i "s|CHANGEME_DBPASS|$(openssl rand -base64 24)|"  .env

# Signs Umami session tokens. Changing it logs everyone out.
APP_SECRET=CHANGEME_SECRET

# PostgreSQL password. Only ever used between the two containers.
POSTGRES_PASSWORD=CHANGEME_DBPASS

# --- used by update-counter.sh, not by docker compose ---

# The Umami account the counter script logs in as. Create a read-only user in
# the Umami UI rather than reusing your admin login.
UMAMI_USERNAME=counter
UMAMI_PASSWORD=CHANGEME_COUNTER_PASS

# Website ID from Umami: Settings -> Websites -> your site -> Edit.
UMAMI_WEBSITE_ID=CHANGEME_WEBSITE_ID
